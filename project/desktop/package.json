{
  "name": "driver-ai-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"wait-on http://localhost:3001 && electron .\"",
    "dev:frontend": "cd ../frontend && npm run dev",
    "dev:backend": "cd ../.. && python main.py",
    "build": "npm run build:frontend && npm run package",
    "build:frontend": "cd ../frontend && npm run build",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "package-all": "electron-builder"
  },
  "dependencies": {
    "electron": "^30.0.0",
    "concurrently": "^8.0.0",
    "wait-on": "^7.0.0",
    "electron-builder": "^24.0.0",
    "electron-store": "^8.0.0",
    "electron-updater": "^6.0.0"
  },
  "devDependencies": {
    "electron-reload": "^2.0.0"
  }
}