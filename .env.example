# [Multi-Key Configuration] - Add your API keys here
# At least ONE of these LLM keys is required for full functionality
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
CHATNOT_API_KEY=your_chatnot_api_key_here

# [Provider Selection] - Choose your primary brain: gpt-4o, gemini-pro, claude-3-5-sonnet
PRIMARY_MODEL=gpt-4o

# [MCP Tools] - Enable/disable tool categories
ENABLE_FILESYSTEM=true
ENABLE_CALENDAR=true
ENABLE_MEMORY=true
ENABLE_SCHEDULER=true

# [Alpha Cowork] - Sandbox workspace root (ALLOWED ZONE)
SANDBOX_ROOT=WORKSPACE
MAX_FILES_PER_OPERATION=100
HITL_THRESHOLD_DELETE=10
HITL_THRESHOLD_MOVE=10

# Frontend environment - API base URL for client
VITE_API_BASE_URL=http://localhost:8000

# Security settings
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
SECRET_KEY=generate_a_strong_secret_key_here

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60